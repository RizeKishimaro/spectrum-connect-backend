generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CallLog {
  id          String        @id @default(cuid())
  callerId    String
  action      String?
  createdAt   DateTime      @default(now())
  agentId     String?
  calleeId    String?
  direction   CallDirection
  duration    Int?
  ringTime    Int?
  connectedAt DateTime?
  hungUpBy    String?
  status      CallStatus
  systemName  String
  updatedAt   DateTime      @updatedAt
  userId      String?
  agent       Agent?        @relation(fields: [agentId], references: [id])
}

model User {
  id              String        @id @default(uuid())
  name            String        @default("System User")
  password        String
  sipUser         String        @unique
  sipPass         String
  createdAt       DateTime      @default(now())
  status          AgentStatus
  email           String
  roles           Role
  systemCompanyId Int
  subscription    Subscription?
  systemCompany   SystemCompany @relation(fields: [systemCompanyId], references: [id])
}

model SmsLog {
  id              String        @id @default(cuid())
  sender          String
  numbers         String
  content         String
  route           Int
  status          String?
  success         Int
  failed          Int
  charged         Float?
  service         String?
  apiRaw          Json
  createdAt       DateTime      @default(now())
  systemCompanyId Int
  direction       String?
  company         SystemCompany @relation(fields: [systemCompanyId], references: [id])

  @@map("sms_logs")
}

model Subscription {
  id              String   @id @default(uuid())
  type            String
  active          Boolean  @default(true)
  userId          String   @unique
  startedAt       DateTime @default(now())
  expiresAt       DateTime
  agentCount      Int
  description     String?
  isSMSSubscribed Boolean  @default(false)
  smsBalance      Float    @default(0.00)
  user            User     @relation(fields: [userId], references: [id])
}

model Agent {
  id               String             @id @default(cuid())
  name             String
  status           AgentStatus        @default(AVAILABLE)
  updatedAt        DateTime           @updatedAt
  firstName        String
  lastName         String
  phoneNumber      String
  sipPassword      String
  sipUname         String             @unique
  systemCompanyId  Int
  password         String
  profilePicture   String?
  createdAt        DateTime           @default(now())
  sipTech          String             @default("pjsip") @map("SipTech")
  systemCompany    SystemCompany      @relation(fields: [systemCompanyId], references: [id])
  AgentPJSIPConfig AgentPJSIPConfig?
  CallLog          CallLog[]
  ParkedCall       ParkedCall[]
  AgentInformation AgentInformation[]
  CheckInOut       CheckInOut[]
}

model CheckInOut {
  id             String   @id @default(cuid())
  checkedInTime  DateTime
  checkedOutTime DateTime
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgentPJSIPConfig {
  id        String   @id @default(cuid())
  agentId   String   @unique
  endpoint  Json
  auth      Json
  aor       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id])
}

model IVRTree {
  id              String        @id @default(cuid())
  name            String        @unique
  tree            Json
  systemCompanyId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         SystemCompany @relation(fields: [systemCompanyId], references: [id])

  @@index([name, id, systemCompanyId])
}

model IvrFiles {
  id              String        @id @default(cuid())
  file_name       String
  file_size       Int
  file_type       String
  file_url        String
  company         SystemCompany @relation(fields: [systemCompanyId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  systemCompanyId Int

  @@map("IvrFiles")
}

model SystemCompany {
  id                   Int                    @id @default(autoincrement())
  name                 String
  membersCount         String
  address              String
  country              String
  state                String
  sIPProviderId        String
  Agent                Agent[]
  IVRTree              IVRTree[]
  ParkedCall           ParkedCall[]
  SIPProvider          SIPProvider            @relation(fields: [sIPProviderId], references: [id])
  User                 User[]
  SmsLog               SmsLog[]
  IvrFiles             IvrFiles[]
  CRMLeads             CRMLeads[]
  CompanyMembers       CompanyMembers[]
  Services             Services[]
  CRMAppointmentStatus CRMAppointmentStatus[]
  Settings             Settings[]
}

model SIPProvider {
  id            String             @id @default(cuid())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  description   String?
  name          String?
  IpHost        String             @default("0.0.0.0")
  SipTech       String             @default("pjsip") @map("SipTech")
  ParkedCall    ParkedCall[]
  RTPAddress    RTPAddress[]
  config        SIPProviderConfig?
  SystemCompany SystemCompany[]
}

model SIPProviderConfig {
  id            String      @id @default(cuid())
  sipProviderId String      @unique
  endpoint      Json
  auth          Json
  aor           Json
  identify      Json
  contact       Json
  SIPProvider   SIPProvider @relation(fields: [sipProviderId], references: [id])
}

model RTPAddress {
  id            String      @id @default(cuid())
  RTPAddress    String
  Name          String
  Remark        String
  sIPProviderId String
  SIPProvider   SIPProvider @relation(fields: [sIPProviderId], references: [id])
}

model CallSession {
  id        String     @id @default(cuid())
  callerId  String
  status    CallStatus
  createdAt DateTime   @default(now())
  type      String
  updatedAt DateTime   @updatedAt
}

model ParkedCall {
  id              String         @id @default(cuid())
  sipChannel      String
  parkedAt        DateTime       @default(now())
  unparkedAt      DateTime?
  isActive        Boolean        @default(true)
  agentId         String?
  sIPProviderId   String?
  DIDNumber       String?
  systemCompanyId Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  agent           Agent?         @relation(fields: [agentId], references: [id])
  sIPProvider     SIPProvider?   @relation(fields: [sIPProviderId], references: [id])
  systemCompany   SystemCompany? @relation(fields: [systemCompanyId], references: [id])
}

model Crm {
  id            String    @id @default(cuid())
  email         String
  phone         String
  companyName   String
  employeeCount String
  companyCount  String
  services      String[]
  isContacted   Boolean   @default(false)
  description   String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  Appointment Appointment[]

  @@index([email])
  @@index([phone])
  @@index([address])
  @@index([companyName])
  @@map("crms")
}

model Appointment {
  id           String            @id @default(cuid())
  crm          Crm               @relation(fields: [crmId], references: [id])
  crmId        String
  scheduledFor DateTime
  status       AppointmentStatus @default(pending)
  note         String? // optional: why the appointment was rescheduled or notes from call
  createdAt    DateTime          @default(now())
  updatedAt    DateTime?         @updatedAt

  @@index([status])
  @@map("appointments")
}

model CRMAppointmentStatus {
  id              String           @id @default(cuid())
  name            String
  systemCompany   SystemCompany    @relation(fields: [systemCompanyId], references: [id])
  systemCompanyId Int
  isDefault       Boolean
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
  CRMAppointment  CRMAppointment[]

  @@index([name])
}

model CRMLeads {
  id            String     @id @default(cuid())
  email         String
  phone         String
  companyName   String
  employeeCount String?
  companyCount  String?
  services      Services[]
  isContacted   Boolean    @default(false)
  locked        Boolean    @default(false)
  contactStatus String?
  description   String?
  address       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime?  @updatedAt

  systemCompany   SystemCompany @relation(fields: [systemCompanyId], references: [id])
  systemCompanyId Int

  Appointment CRMAppointment[]

  @@index([email])
  @@index([phone])
  @@index([address])
  @@index([companyName])
}

model CRMAppointment {
  id                     String               @id @default(cuid())
  scheduledFor           DateTime
  companyMembers         CompanyMembers       @relation(fields: [companyMembersId], references: [id])
  CRMLeads               CRMLeads?            @relation(fields: [cRMLeadsId], references: [id])
  status                 CRMAppointmentStatus @relation(fields: [cRMAppointmentStatusId], references: [id])
  note                   String?
  cRMLeadsId             String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime?            @updatedAt
  cRMAppointmentStatusId String
  companyMembersId       String
}

model CompanyMembers {
  id   String @id @default(cuid())
  name String

  SystemCompany    SystemCompany    @relation(fields: [systemCompanyId], references: [id])
  systemCompanyId  Int
  cRMAppointmentId String?
  CRMAppointment   CRMAppointment[]
}

model Services {
  id              String        @id @default(cuid())
  name            String
  systemCompany   SystemCompany @relation(fields: [systemCompanyId], references: [id])
  systemCompanyId Int

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  CRMLeads   CRMLeads? @relation(fields: [cRMLeadsId], references: [id])
  cRMLeadsId String?
}

model SIPEndpoints {
  id         String       @id @default(cuid())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  name       String
  ipHost     String       @default("0.0.0.0")
  sipTech    String       @default("pjsip")
  settings   Settings[]
  DIDNumbers DIDNumbers[]
}

model DIDNumbers {
  id             String        @id @default(cuid())
  didNumber      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  SIPEndpoints   SIPEndpoints? @relation(fields: [sIPEndpointsId], references: [id])
  sIPEndpointsId String?
  Settings       Settings[]
}

model Extensions {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  name      String
  didNumber String     @default("")
  settings  Settings[]
}

model AgentInformation {
  id                   String   @id @default(cuid())
  isInPredictiveDialer Boolean  @default(false)
  Agent                Agent    @relation(fields: [agentId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  agentId              String
}

model Settings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blastCount   Int     @default(2)
  callLimit    Int     @default(100)
  introFileUrl String? // path to client intro audio

  sipProvider   SIPEndpoints? @relation(fields: [sipProviderId], references: [id])
  sipProviderId String?

  systemCompanyId Int
  systemCompany   SystemCompany @relation(fields: [systemCompanyId], references: [id])

  DIDNumber   DIDNumbers? @relation(fields: [dIDNumberId], references: [id])
  dIDNumberId String?

  ivr   Extensions? @relation(fields: [ivrId], references: [id])
  ivrId String?
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

enum SIPTech {
  PJSIP
  SIP
  SKINNY
  IAX
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum AgentStatus {
  AVAILABLE
  RINGING
  BUSY
  OFFLINE
}

enum CallStatus {
  CONNECTION_ERROR
  REQUEST_TIMEOUT
  SIP_FAILURE_CODE
  INTERNAL_ERROR
  BUSY
  REJECTED
  REDIRECTED
  UNAVAILABLE
  NOT_FOUND
  ADDRESS_INCOMPLETE
  INCOMPATIBLE_SDP
  MISSING_SDP
  AUTHENTICATION_ERROR
  BYE
  WEBRTC_ERROR
  CANCELED
  NO_ANSWER
  EXPIRES
  NO_ACK
  DIALOG_ERROR
  USER_DENIED_MEDIA_ACCESS
  BAD_MEDIA_DESCRIPTION
  RTP_TIMEOUT
  WAITING
  RINGING
  CONNECTED
  HUNGUP
  FAILED
  MISSED
  TRANSFERRED
}

enum Role {
  admin
  company_user
}
