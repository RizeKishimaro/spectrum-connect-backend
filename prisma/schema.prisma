generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CallLog {
  id         String        @id @default(cuid())
  callerId   String
  action     String?
  createdAt  DateTime      @default(now())
  agentId    String?
  calleeId   String?
  direction  CallDirection
  duration   Int?
  hungUpBy   String?
  status     CallStatus
  systemName String
  updatedAt  DateTime      @updatedAt
  userId     String?
  agent      Agent?        @relation(fields: [agentId], references: [id])
}

model User {
  id              String        @id @default(uuid())
  name            String        @default("System User")
  password        String
  sipUser         String        @unique
  sipPass         String
  createdAt       DateTime      @default(now())
  status          AgentStatus
  email           String
  roles           Role
  systemCompanyId Int
  subscription    Subscription?
  systemCompany   SystemCompany @relation(fields: [systemCompanyId], references: [id])
}

model SmsLog {
  id              String        @id @default(cuid())
  sender          String
  numbers         String
  content         String
  route           Int
  status          String?
  success         Int
  failed          Int
  charged         Float?
  apiRaw          Json
  createdAt       DateTime      @default(now())
  systemCompanyId Int
  direction       String?
  company         SystemCompany @relation(fields: [systemCompanyId], references: [id])

  @@map("sms_logs")
}

model Subscription {
  id              String   @id @default(uuid())
  type            String
  active          Boolean  @default(true)
  userId          String   @unique
  startedAt       DateTime @default(now())
  expiresAt       DateTime
  agentCount      Int
  description     String?
  isSMSSubscribed Boolean  @default(false)
  user            User     @relation(fields: [userId], references: [id])
}

model Agent {
  id               String            @id @default(cuid())
  name             String
  status           AgentStatus       @default(AVAILABLE)
  updatedAt        DateTime          @updatedAt
  firstName        String
  lastName         String
  phoneNumber      String
  sipPassword      String
  sipUname         String            @unique
  systemCompanyId  Int
  password         String
  profilePicture   String?
  createdAt        DateTime          @default(now())
  sipTech          String            @default("pjsip") @map("SipTech")
  systemCompany    SystemCompany     @relation(fields: [systemCompanyId], references: [id])
  AgentPJSIPConfig AgentPJSIPConfig?
  CallLog          CallLog[]
  ParkedCall       ParkedCall[]
}

model AgentPJSIPConfig {
  id        String   @id @default(cuid())
  agentId   String   @unique
  endpoint  Json
  auth      Json
  aor       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id])
}

model IVRTree {
  id              String        @id @default(cuid())
  name            String
  tree            Json
  systemCompanyId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         SystemCompany @relation(fields: [systemCompanyId], references: [id])
}

model IvrFiles {
  id              String        @id @default(cuid())
  file_name       String
  file_size       Int
  file_type       String
  file_url        String
  company         SystemCompany @relation(fields: [systemCompanyId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  systemCompanyId Int
}

model SystemCompany {
  id            Int          @id @default(autoincrement())
  name          String
  membersCount  String
  address       String
  country       String
  state         String
  sIPProviderId String
  Agent         Agent[]
  IVRTree       IVRTree[]
  ParkedCall    ParkedCall[]
  SIPProvider   SIPProvider  @relation(fields: [sIPProviderId], references: [id])
  User          User[]
  SmsLog        SmsLog[]
  IvrFiles      IvrFiles[]
}

model SIPProvider {
  id            String             @id @default(cuid())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  description   String?
  name          String?
  SipTech       String             @default("pjsip") @map("SipTech")
  ParkedCall    ParkedCall[]
  RTPAddress    RTPAddress[]
  config        SIPProviderConfig?
  SystemCompany SystemCompany[]
}

model SIPProviderConfig {
  id            String      @id @default(cuid())
  sipProviderId String      @unique
  endpoint      Json
  auth          Json
  aor           Json
  identify      Json
  contact       Json
  SIPProvider   SIPProvider @relation(fields: [sipProviderId], references: [id])
}

model RTPAddress {
  id            String      @id @default(cuid())
  RTPAddress    String
  Name          String
  Remark        String
  sIPProviderId String
  SIPProvider   SIPProvider @relation(fields: [sIPProviderId], references: [id])
}

model CallSession {
  id        String     @id @default(cuid())
  callerId  String
  status    CallStatus
  createdAt DateTime   @default(now())
  type      String
  updatedAt DateTime   @updatedAt
}

model ParkedCall {
  id              String         @id @default(cuid())
  sipChannel      String
  parkedAt        DateTime       @default(now())
  unparkedAt      DateTime?
  isActive        Boolean        @default(true)
  agentId         String?
  sIPProviderId   String?
  DIDNumber       String?
  systemCompanyId Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  agent           Agent?         @relation(fields: [agentId], references: [id])
  sIPProvider     SIPProvider?   @relation(fields: [sIPProviderId], references: [id])
  systemCompany   SystemCompany? @relation(fields: [systemCompanyId], references: [id])
}

enum SIPTech {
  PJSIP
  SIP
  SKINNY
  IAX
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum AgentStatus {
  AVAILABLE
  RINGING
  BUSY
  OFFLINE
}

enum CallStatus {
  CONNECTION_ERROR
  REQUEST_TIMEOUT
  SIP_FAILURE_CODE
  INTERNAL_ERROR
  BUSY
  REJECTED
  REDIRECTED
  UNAVAILABLE
  NOT_FOUND
  ADDRESS_INCOMPLETE
  INCOMPATIBLE_SDP
  MISSING_SDP
  AUTHENTICATION_ERROR
  BYE
  WEBRTC_ERROR
  CANCELED
  NO_ANSWER
  EXPIRES
  NO_ACK
  DIALOG_ERROR
  USER_DENIED_MEDIA_ACCESS
  BAD_MEDIA_DESCRIPTION
  RTP_TIMEOUT
  WAITING
  RINGING
  CONNECTED
  HUNGUP
  FAILED
  MISSED
  TRANSFERRED
}

enum Role {
  admin
  company_user
}
